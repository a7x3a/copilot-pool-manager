{
  "name": "copilot-pool-manager",
  "version": "1.0.0",
  "description": "Windows-first CLI application for managing multiple independently authorized GitHub Copilot accounts",
  "main": "dist/cli/index.js",
  "bin": {
    "cpm": "./bin/cpm.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/db/migrate.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "copilot",
    "github-copilot",
    "cli",
    "account-manager",
    "windows",
    "pool",
    "orchestrator",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.38.4",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/prompts": "^2.4.9",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
